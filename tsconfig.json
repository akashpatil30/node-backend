{
  "compilerOptions": {
    "module": "ESNext",       // Use ES module syntax (import/export)
    "target": "ESNext",       // Output modern JavaScript
    "moduleResolution": "node", // Use Node.js module resolution
    "esModuleInterop": true,  // Allow compatibility with CommonJS modules
    "strict": true,           // Enable strict type-checking
    "skipLibCheck": true,     // Skip checking of declaration files for faster builds
    "forceConsistentCasingInFileNames": true, // Ensure consistent file name casing
    "outDir": "./dist",       // Output compiled JavaScript to the dist folder
    "allowJs": true,
    "lib": ["es2020", "dom"],
    "types": ["node", "express"]           // Allow JavaScript files in your project
  },
  "include": ["src/**/*"],    // Include all files in the src folder
  "exclude": ["node_modules", "dist"] // Exclude node_modules and dist folders
}